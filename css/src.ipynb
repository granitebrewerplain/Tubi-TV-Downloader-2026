import numpy as np  
import pandas as pd  
import matplotlib.pyplot as plt  
data = np.random.randn(100)  
plt.hist(data, bins=10, alpha=0.7)  
plt.title('Histogram of Random Data')  
plt.xlabel('Value')  
plt.ylabel('Frequency')  
plt.grid(axis='y', alpha=0.75)  
plt.show()
